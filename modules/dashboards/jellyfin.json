        { "expr": "jellyfin_library_item_count{type=\"Episode\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Session History",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "jellyfin_session_count", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
