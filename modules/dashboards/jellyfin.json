    },
    {
      "type": "stat",
      "title": "Jellyfin Health",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "targets": [
        { "expr": "up{job=\"jellyfin\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
